# IPFS Pinning Service Configuration (SQLite Backend)

# Server Configuration
PORT=6000

# Database Configuration (SQLite - path relative to working directory)
DATABASE_PATH=data/pinning.db

# IPFS Configuration
IPFS_API_ADDR=/ip4/127.0.0.1/tcp/5001

# Blockchain Configuration
BLOCKCHAIN_API_ENDPOINT=http://blockchain-api-endpoint
MASTER_SEED=your_master_seed_value
POOL_SEED=your_pool_seed_value
POOL_ID=1

# Admin API Configuration (system-only endpoints)
# Generate a secure random key for production use
SYSTEM_KEY=your_secure_system_key_here