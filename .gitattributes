# Auto detect text files and perform LF normalization
* text=auto

# Keep vendored third-party prompt assets stable across Windows and Ubuntu.
ai/skills/** text eol=lf
ai/third_party/emilkowalski-skills/** text eol=lf

# Shell scripts MUST stay LF. A CRLF shell script fails on Linux with the
# opaque $'\r': command not found.
*.sh text eol=lf
