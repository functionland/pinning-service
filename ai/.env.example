# Server
PORT=3002
NODE_ENV=production

# Claude API
CLAUDE_API_KEY=sk-ant-...
# Multipass generation requires a Claude 4.6+ model (adaptive thinking).
CLAUDE_MODEL=claude-opus-5
# Applies the pinned Emil Kowalski design-engineering skill as system-prompt
# guidance. Set false only for emergency rollback to the legacy prompt.
CLAUDE_DESIGN_SKILL_ENABLED=true
# Multi-pass website generation (brief -> build -> polish). Set false to
# revert every request to the single-pass pipeline (emergency kill-switch).
CLAUDE_MULTIPASS_ENABLED=true
# Per-pass output-token budgets (thinking tokens count against these).
# Brief went 16000 -> 32000 on 2026-09-12: a production job logged
# `Pass brief: out=16000` then `Brief truncated at the token budget` — adaptive
# thinking at effort=high ate the whole budget and the art direction was cut off.
CLAUDE_BRIEF_MAX_TOKENS=32000
CLAUDE_BUILD_MAX_TOKENS=96000
CLAUDE_POLISH_MAX_TOKENS=64000

# Generation
# Base cost for a single website generation when click-tracking is OFF.
GENERATION_COST_FULA=1000
# Surcharged cost when the request opts into click-tracking
# (the FxFiles "Enable click tracking" toggle).
GENERATION_COST_FULA_WITH_TRACKING=1500
FREE_GENERATIONS_PER_USER=1
MAX_CONCURRENT_JOBS=3
# 15 min — multi-pass generation legitimately runs past the old 5-min cap
# (new clients poll for up to 20 minutes).
JOB_TIMEOUT_MS=900000
MAX_JOBS_PER_USER_PER_HOUR=10

# Social posts (captions via Claude + 4:5 image via Gemini)
# Empty GEMINI_API_KEY disables the feature (POST /social/generate -> 503).
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# 1K or 2K
GEMINI_IMAGE_SIZE=1K
# Cheaper model for captions; empty falls back to CLAUDE_MODEL.
CLAUDE_SOCIAL_MODEL=
SOCIAL_POST_PRICE_FULA=300
MAX_CONCURRENT_SOCIAL_JOBS=2
SOCIAL_JOB_TIMEOUT_MS=300000
MAX_SOCIAL_JOBS_PER_USER_PER_HOUR=10
SOCIAL_MAX_REFERENCE_IMAGES=8
# Extra hosts a reference image may be fetched from when an asset carries no
# CID. Leading '.' matches subdomains (the app's default gateway is the
# subdomain-style <cid>.ipfs.dweb.link). Assets WITH a CID are always fetched
# from IPFS_GATEWAY_URL instead, so this is only a legacy fallback.
SOCIAL_REF_ALLOWED_HOSTS=.dweb.link,.w3s.link,.ipfs.io
# Bucket the finished social JPEG lands in (client-owned public assets bucket).
SOCIAL_ASSETS_BUCKET=website-assets
# When set (e.g. https://ai.cloud.fx.land), clients get MIME-passthrough image
# URLs ({base}/api/v1/social/image/{cid}) instead of raw gateway URLs.
SOCIAL_PUBLIC_BASE_URL=
BUFFER_API_URL=https://api.buffer.com

# IPFS
IPFS_API_URL=http://127.0.0.1:5001
IPFS_GATEWAY_URL=https://ipfs.cloud.fx.land/gateway

# S3 Gateway (fula-api) — user's JWT is forwarded for authentication
S3_GATEWAY_URL=http://127.0.0.1:9000
S3_BUCKET_NAME=ai-websites

# Click-tracking analytics endpoint (fxfiles-analytics).
# Only used when a /generate request opts in via `enable_tracking: true`.
ANALYTICS_ENDPOINT_URL=https://analytics.fx.land

# Pinning Service Integration
PINNING_WEBUI_URL=http://127.0.0.1:3001
PINNING_SYSTEM_KEY=your_system_key

# JWT (shared with other services)
JWT_SECRET=your_jwt_secret

# PostgreSQL (shared with pinning-service)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pinning_service
POSTGRES_USER=pinning_user
POSTGRES_PASSWORD=your_password
POSTGRES_SSL=false
