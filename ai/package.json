{
  "name": "fula-ai-service",
  "version": "1.0.0",
  "description": "AI Website Generation Service for FxFiles",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node node_modules/typescript/bin/tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@hono/node-server": "^1.19.14",
    "dotenv": "^16.4.7",
    "hono": "^4.12.28",
    "jose": "^5.9.6",
    "mammoth": "^1.12.0",
    "officeparser": "^5.2.2",
    "pg": "^8.11.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "uuid": "^11.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.10.9",
    "@types/uuid": "^10.0.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "form-data": "^4.0.6"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
