{
  "name": "ipfs-gateway",
  "version": "2.0.0",
  "description": "IPFS Gateway and Upload Server with PostgreSQL authentication",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "npm run build:bundle && npm run build:binary",
    "build:bundle": "esbuild server.js --bundle --platform=node --format=cjs --target=node20 --outfile=dist/bundle.cjs --external:pg --external:pg-native",
    "build:binary": "pkg ./dist/bundle.cjs --target node20-linux-x64 -o ./dist/ipfs-gateway --public --no-bytecode",
    "dev": "node --watch server.js",
    "test": "node --test test/server.test.js",
    "test:setup": "node test/setup-test-db.js"
  },
  "pkg": {
    "assets": [
      "node_modules/kubo-rpc-client/**/*",
      "node_modules/file-type/**/*",
      "node_modules/heic-convert/**/*"
    ],
    "targets": [
      "node20-linux-x64"
    ],
    "outputPath": "dist"
  },
  "dependencies": {
    "express": "^4.21.2",
    "file-type": "^19.6.0",
    "kubo-rpc-client": "^5.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.11.3",
    "heic-convert": "^2.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "@yao-pkg/pkg": "^6.14.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
