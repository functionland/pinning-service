# FULA Pinning WebUI Configuration

# Server port
WEBUI_PORT=3001

# Node environment (development or production)
NODE_ENV=production

# ============================================
# Database Configuration
# ============================================
# Option 1: SQLite (default, path to shared database)
DATABASE_PATH=/home/root/pinning-service/data/pinning.db

# Option 2: PostgreSQL (takes precedence if POSTGRES_HOST is set)
# For production use with multiple apps accessing the database
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=pinning_service
# POSTGRES_USER=pinning_user
# POSTGRES_PASSWORD=your_secure_password
# POSTGRES_SSL=false
# POSTGRES_MAX_CONNECTIONS=25
# POSTGRES_IDLE_TIMEOUT=30000
# POSTGRES_CONNECTION_TIMEOUT=5000

# Google OAuth Client ID (required for authentication)
# Get this from Google Cloud Console: https://console.cloud.google.com/apis/credentials
# NOTE: You need BOTH variables set to the same value:
#   - GOOGLE_CLIENT_ID is used by the backend server
#   - VITE_GOOGLE_CLIENT_ID is used by the frontend (Vite requires VITE_ prefix)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Session secret (generate a random string for production)
SESSION_SECRET=your-secure-random-session-secret

# JWT secret for API key generation (generate a random string for production)
# If not set, falls back to SESSION_SECRET
JWT_SECRET=your-secure-jwt-secret

# Pinning service URL (for API calls like refresh status)
PINNING_SERVICE_URL=http://localhost:6000

# System key for x402 gateway integration (optional)
# If set, allows x402 gateway to adjust credits via /api/admin/adjust
# Must match PINNING_SYSTEM_KEY in x402-skale .env
PINNING_SYSTEM_KEY=your-secure-system-key
