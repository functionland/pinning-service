# FULA Pinning WebUI Configuration

# Server port
WEBUI_PORT=3001

# Node environment (development or production)
NODE_ENV=production

# Path to SQLite database (same as pinning service)
DATABASE_PATH=/home/root/pinning-service/data/pinning.db

# Google OAuth Client ID (required for authentication)
# Get this from Google Cloud Console: https://console.cloud.google.com/apis/credentials
# NOTE: You need BOTH variables set to the same value:
#   - GOOGLE_CLIENT_ID is used by the backend server
#   - VITE_GOOGLE_CLIENT_ID is used by the frontend (Vite requires VITE_ prefix)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Session secret (generate a random string for production)
SESSION_SECRET=your-secure-random-session-secret

# Pinning service URL (for API calls like refresh status)
PINNING_SERVICE_URL=http://localhost:6000
