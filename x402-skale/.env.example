# x402-skale Gateway Configuration

# ============================================
# Server Configuration
# ============================================
PORT=4002
NODE_ENV=development

# ============================================
# x402 Payment Configuration (SKALE)
# ============================================
# Facilitator URL
# Corbits: https://facilitator.corbits.dev (recommended, supports x402 v1)
# See https://x402.org for documentation
FACILITATOR_URL=https://facilitator.corbits.dev

# Receiving wallet address for payments
RECEIVING_ADDRESS=0xYourReceivingWalletAddress

# SKALE Base chain (see https://x402.org for supported networks)
# Chain ID for EIP-712 signing
NETWORK_CHAIN_ID=1187947933
# Network name for facilitator API (must match facilitator's supported networks)
# Options: skale-base, skale-base-spolia, base-sepolia, base, etc.
NETWORK_NAME=skale-base

# USDC token address on SKALE Base
PAYMENT_TOKEN_ADDRESS=0x85889c8c714505E0c94b30fcfcF64fE3Ac8FCb20
# Token name for EIP-712 domain (must match token contract's name())
PAYMENT_TOKEN_NAME=USD Coin
# Token version for EIP-712 domain (USDC is typically "2")
PAYMENT_TOKEN_VERSION=2

# ============================================
# S3 Backend Configuration (pass-through proxy)
# ============================================
S3_BACKEND_URL=http://127.0.0.1:9000

# S3 Admin Token (required for cleanup cron to delete expired users)
# Generate an admin JWT with scope: "admin"
S3_ADMIN_TOKEN=your_s3_admin_token_here

# ============================================
# Pinning Service Integration
# ============================================
PINNING_WEBUI_URL=http://127.0.0.1:3001
PINNING_SYSTEM_KEY=your_system_key_here

# ============================================
# Database Configuration
# ============================================
# Option 1: SQLite (default, local database for x402)
DATABASE_PATH=./data/x402.db

# Option 2: PostgreSQL (takes precedence if POSTGRES_HOST is set)
# For production use with shared database across all apps
# x402 tables (x402_payment_logs, x402_ephemeral_objects) are in the shared DB
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=pinning_service
# POSTGRES_USER=pinning_user
# POSTGRES_PASSWORD=your_secure_password
# POSTGRES_SSL=false

# ============================================
# Pricing Configuration
# ============================================
# Base price: $0.01 per MB-hour (in microUSDC, 6 decimals)
BASE_PRICE_MICRO_USDC=10000

# Minimum payment (in microUSDC)
MIN_PAYMENT_MICRO_USDC=1000

# FULA exchange rate (USDC to FULA for pinning credits)
FULA_EXCHANGE_RATE=1.0
