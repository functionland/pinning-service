{
  "name": "x402-skale-gateway",
  "version": "1.0.0",
  "description": "x402 Payment Gateway for Fula Storage on SKALE",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:test": "cp .env.test .env && tsx watch src/index.ts",
    "build": "node node_modules/typescript/bin/tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:local": "tsx scripts/local-test.ts",
    "migrate": "./node_modules/.bin/tsx scripts/migrate.ts",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "dotenv": "^16.4.7",
    "hono": "^4.11.7",
    "jose": "^5.9.6",
    "pg": "^8.11.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "uuid": "^11.0.3",
    "viem": "^2.21.54",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.10.9",
    "@types/uuid": "^10.0.0",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
